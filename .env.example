MINECRAFT_HOST=localhost
MINECRAFT_PORT=3122
BOT_USERNAME=animabot
WORLD_NAME=world1

# LLM Configuration
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1/
CHAT_MODEL_NAME=gemini-2.5-pro
CODING_MODEL_NAME=gemini-3-flash-preview
MEMORY_MODEL_NAME=gemini-2.5-pro

# Prompt Paths
PROMPT_PATH=agent/prompts

# Puppeteer 以无头模式运行（默认，无需设置）
# HEADLESS=false

# 禁用 prismarine-viewer（截图功能）
PRISMARINE_VIEWER=false

# ==================== Observer Vision（真实客户端观测） ====================
# 默认用于“和 agent.core 一起运行”场景：
# - agent.core 占用 8000
# - observer-client 连接 Python 后端 /ws/vision
OBS_TARGET_BOT=animabot
OBS_WS_URL=ws://127.0.0.1:18000/ws/vision

# 独立联调 mock-vision-server 时不要占用 8000，改用 18000：
# PowerShell:
#   $env:MOCK_VISION_PORT="18000"
#   $env:OBS_WS_URL="ws://127.0.0.1:18000/ws/vision"
# CMD:
#   set MOCK_VISION_PORT=18000
#   set OBS_WS_URL=ws://127.0.0.1:18000/ws/vision
# Bash:
#   export MOCK_VISION_PORT=18000
#   export OBS_WS_URL=ws://127.0.0.1:18000/ws/vision